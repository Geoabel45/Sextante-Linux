#!/bin/bash

MARKER="$HOME/.config/.sextante-plasma-configurado"

[ -f "$MARKER" ] && exit 0

for i in {1..30}; do
    qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && break
    sleep 1
done

SCRIPT='
var desktopsList = desktops();

for (var d = 0; d < desktopsList.length; d++) {
    var desktop = desktopsList[d];

    desktop.wallpaperPlugin = "org.kde.image";
    desktop.currentConfigGroup = [
        "Wallpaper",
        "org.kde.image",
        "General"
    ];

    desktop.writeConfig(
        "Image",
        "file:///usr/share/wallpapers/SextanteLinux/contents/images/wallpaperprincipal.svg"
    );
    desktop.writeConfig("FillMode", "6");
    desktop.writeConfig("SlidePaths", "/usr/share/wallpapers/");
    desktop.reloadConfig();
}

var oldPanels = panels();

for (var i = 0; i < oldPanels.length; i++) {
    oldPanels[i].remove();
}

var panel = new Panel;
panel.location = "bottom";
panel.height = 44;

var kickoff = panel.addWidget("org.kde.plasma.kickoff");
kickoff.currentConfigGroup = ["General"];
kickoff.writeConfig("icon", "/usr/share/pixmaps/sextantelinux/menu-inicio.svg");

var launcher = panel.addWidget("org.kde.plasma.icontasks");
launcher.currentConfigGroup = ["General"];

launcher.writeConfig(
    "launchers",
    "applications:sextante-browser.desktop," +
    "applications:sextante-files.desktop," +
    "applications:sextante-terminal.desktop," +
    "applications:sextante-settings.desktop," +
    "applications:org.qgis.qgis.desktop," +
    "applications:grass.desktop," +
    "applications:org.freecad.FreeCAD.desktop"
);

panel.addWidget("org.kde.plasma.panelspacer");

panel.addWidget("org.kde.plasma.systemmonitor.cpu");
panel.addWidget("org.kde.plasma.systemmonitor.memory");

panel.addWidget("org.kde.plasma.weather");

panel.addWidget("org.kde.plasma.systemtray");
panel.addWidget("org.kde.plasma.digitalclock");
'

if qdbus6 org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript "$SCRIPT"; then
    touch "$MARKER"
fi
